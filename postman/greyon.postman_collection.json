{
  "info": {
    "name": "Greyon Hotel Booking API",
    "description": "Routes organized from web.php, auth.php, admin.php. Session-cookie auth (Breeze-style, no Sanctum) — turn cookies on (on by default), log in once under Admin > Auth or Front > Auth, and every other request authenticates automatically via the shared cookie jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://greyon.info" }
  ],
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/admin/login",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"email\": \"admin@greyon.test\",\n    \"password\": \"password\"\n}"
                }
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{base_url}}/admin/logout"
              }
            },
            {
              "name": "Forgot Password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/admin/forgot-password",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"email\": \"admin@greyon.test\"\n}"
                }
              }
            },
            {
              "name": "Reset Password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/admin/reset-password",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"token\": \"paste-token-from-storage/logs/laravel.log\",\n    \"email\": \"admin@greyon.test\",\n    \"password\": \"newpassword\",\n    \"password_confirmation\": \"newpassword\"\n}"
                }
              }
            },
            {
              "name": "Confirm Password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/admin/confirm-password",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"password\": \"password\"\n}"
                }
              }
            },
            {
              "name": "Update Password",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/admin/password",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"current_password\": \"password\",\n    \"password\": \"newpassword\",\n    \"password_confirmation\": \"newpassword\"\n}"
                }
              }
            }
          ]
        },
        {
          "name": "Current Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/admin/me"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/admin/dashboard"
          }
        }
      ]
    },
    {
      "name": "Front",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Verify",
              "item": [
                {
                  "name": "Verify Email Notice",
                  "request": {
                    "method": "GET",
                    "header": [{ "key": "Accept", "value": "application/json" }],
                    "url": "{{base_url}}/verify-email"
                  }
                },
                {
                  "name": "Resend Verification Email",
                  "request": {
                    "method": "POST",
                    "header": [{ "key": "Accept", "value": "application/json" }],
                    "url": "{{base_url}}/email/verification-notification"
                  }
                },
                {
                  "name": "Confirm Password",
                  "request": {
                    "method": "POST",
                    "header": [
                      { "key": "Content-Type", "value": "application/json" },
                      { "key": "Accept", "value": "application/json" }
                    ],
                    "url": "{{base_url}}/confirm-password",
                    "body": {
                      "mode": "raw",
                      "options": { "raw": { "language": "json" } },
                      "raw": "{\n    \"password\": \"password\"\n}"
                    }
                  }
                }
              ]
            },
            {
              "name": "Guest",
              "item": [
                {
                  "name": "Dashboard",
                  "request": {
                    "method": "GET",
                    "header": [{ "key": "Accept", "value": "application/json" }],
                    "url": "{{base_url}}/dashboard"
                  }
                }
              ]
            },
            {
              "name": "Manager",
              "item": [
                {
                  "name": "Dashboard",
                  "request": {
                    "method": "GET",
                    "header": [{ "key": "Accept", "value": "application/json" }],
                    "url": "{{base_url}}/manager"
                  }
                }
              ]
            },
            {
              "name": "Register",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/register",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane@example.com\",\n    \"password\": \"password\",\n    \"password_confirmation\": \"password\",\n    \"phone\": \"012345678\"\n}"
                }
              }
            },
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/login",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"email\": \"guest@greyon.test\",\n    \"password\": \"password\"\n}"
                }
              }
            },
            {
              "name": "Login with Google (open in browser, not Bruno)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{base_url}}/auth/google/redirect",
                "description": "This is a browser redirect flow (Google's consent screen), so Bruno's Send button can't complete it. Paste {{base_url}}/auth/google/redirect into an actual browser tab instead; Google sends it back to /auth/google/callback, which logs the guest in and hands back the same cookie session every other request here uses."
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{base_url}}/logout"
              }
            },
            {
              "name": "Forgot Password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/forgot-password",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"email\": \"guest@greyon.test\"\n}"
                }
              }
            },
            {
              "name": "Reset Password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/reset-password",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"token\": \"paste-token-from-storage/logs/laravel.log\",\n    \"email\": \"guest@greyon.test\",\n    \"password\": \"newpassword\",\n    \"password_confirmation\": \"newpassword\"\n}"
                }
              }
            },
            {
              "name": "Update Password",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": "{{base_url}}/password",
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n    \"current_password\": \"password\",\n    \"password\": \"newpassword\",\n    \"password_confirmation\": \"newpassword\"\n}"
                }
              }
            },
            {
              "name": "Current User",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{base_url}}/user"
              }
            }
          ]
        }
      ]
    }
  ]
}
